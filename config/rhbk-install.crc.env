# New installations only. Copy to .private/rhbk-install.env and edit.
# This file contains names and references, never credentials.
# Same keys for CRC and other OpenShift clusters; values are environment-specific.
# Replace every REPLACE_WITH marker before the corresponding step.
# RHBK_IMAGE is set after the exact Build completes.
# PG_* applies only to the optional demonstration database.
KUBECONFIG=/absolute/path/crc.kubeconfig
CONTEXT=crc-admin
EXPECTED_SERVER=https://api.crc.testing:6443
NAMESPACE=rhbk-rotation-lab
ARCHITECTURE=arm64
RHBK_CA_FILE=/absolute/path/crc-router-ca.crt
OPERATOR_GROUP=rhbk-rotation-lab
OPERATOR_CHANNEL=stable-v26.6
OPERATOR_CSV=rhbk-operator.v26.6.9-opr.1
OPERATOR_CATALOG=redhat-operators
OPERATOR_CATALOG_NAMESPACE=openshift-marketplace
BUILD_NAME=rhbk-optimized
RHBK_BASE_IMAGE=registry.redhat.io/rhbk/keycloak-rhel9@sha256:REPLACE_WITH_VERIFIED_DIGEST
RHBK_IMAGE=image-registry.openshift-image-registry.svc:5000/rhbk-rotation-lab/rhbk-optimized@sha256:REPLACE_WITH_COMPLETED_BUILD_DIGEST
RHBK_NAME=rhbk
RHBK_HOSTNAME=rhbk-rotation.apps-crc.testing
RHBK_INSTANCES=1
RHBK_CPU_REQUEST=500m
RHBK_MEMORY_REQUEST=768Mi
RHBK_CPU_LIMIT=2
RHBK_MEMORY_LIMIT=1536Mi
DB_HOST=postgresql
DB_PORT=5432
DB_NAME=keycloak
DB_USERNAME_SECRET=postgres-credential
DB_USERNAME_KEY=username
DB_PASSWORD_SECRET=postgres-credential
DB_PASSWORD_KEY=password
BOOTSTRAP_SECRET=rhbk-bootstrap
PG_NAME=postgresql
PG_IMAGE=registry.redhat.io/rhel9/postgresql-16@sha256:REPLACE_WITH_VERIFIED_DIGEST
PG_STORAGE_CLASS=crc-csi-hostpath-provisioner
PG_STORAGE_SIZE=1Gi
