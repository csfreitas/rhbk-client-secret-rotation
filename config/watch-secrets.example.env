# Valores literais, sem aspas, source/eval, ~ ou expansão de $HOME.
# Precedência: padrões < ambiente < este arquivo explícito < argumentos CLI.
# Use caminhos absolutos para executar a partir de qualquer diretório.
KUBECONFIG=/caminho/para/kubeconfig
CONTEXT=meu-contexto
EXPECTED_SERVER=https://api.meu-cluster.example:6443
NAMESPACE=rhbk-rotation-demo
STATE_CONFIGMAP=rotation-state
RHBK_URL=https://rhbk.meu-cluster.example
REALM=rotation-demo
CLIENT_ID=rotation-demo-m2m
# Vazio usa confiança TLS do sistema; nunca há opção insecure.
CA_FILE=
INTERVAL_SECONDS=2
# 0 observa continuamente; --once ou --duration substituem este comportamento.
DURATION_SECONDS=0
# Vazio desativa relatório. Caminho informado deve ser novo; TSV criado com 0600.
REPORT_FILE=
WATCH_TZ=America/Sao_Paulo
