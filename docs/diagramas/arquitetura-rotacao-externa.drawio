        <mxCell id="automatic" value="&lt;div style=&quot;font-size:18px;line-height:1.25;text-align:center;&quot;&gt;&lt;b&gt;Decisão externa da rotação&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;font-weight:normal;color:#4B5563&quot;&gt;Exemplo: elegível após 300 s; CronJob avalia a cada minuto.&lt;br&gt;O instante do próximo POST depende do agendamento.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#F08C00;strokeWidth=2;fontColor=#1F2937;spacing=10;arcSize=12;" vertex="1" parent="1">
