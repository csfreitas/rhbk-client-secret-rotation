        <mxCell id="subtitle" value="O POST renova a validade de S2; os processos continuam com S1 até o rollout. Os tempos abaixo são parâmetros de exemplo." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontSize=16;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="82" width="1520" height="35" />
        </mxCell>
        <mxCell id="step0" value="&lt;div style=&quot;font-size:18px;line-height:1.25;text-align:center;&quot;&gt;&lt;b&gt;1. Avaliar e registrar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;font-weight:normal;color:#4B5563&quot;&gt;Adquire Lease; valida S1&lt;br&gt;Persiste a intenção da operação&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#E67700;strokeWidth=2;fontColor=#1F2937;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="155" width="310" height="125" />
        </mxCell>
        <mxCell id="step1" value="&lt;div style=&quot;font-size:18px;line-height:1.25;text-align:center;&quot;&gt;&lt;b&gt;2. Gerar e persistir&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;font-weight:normal;color:#4B5563&quot;&gt;POST gera S2; lê os metadados&lt;br&gt;Cria Secret vN+1 imutável&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F0;strokeColor=#C92A2A;strokeWidth=2;fontColor=#1F2937;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="155" width="310" height="125" />
        </mxCell>
        <mxCell id="step2" value="&lt;div style=&quot;font-size:18px;line-height:1.25;text-align:center;&quot;&gt;&lt;b&gt;3. Substituir os pods&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;font-weight:normal;color:#4B5563&quot;&gt;Espera 45 s; inicia rollout&lt;br&gt;Novos pods carregam S2&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2F6FB0;strokeWidth=2;fontColor=#1F2937;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="840" y="155" width="310" height="125" />
        </mxCell>
        <mxCell id="step3" value="&lt;div style=&quot;font-size:18px;line-height:1.25;text-align:center;&quot;&gt;&lt;b&gt;4. Verificar e concluir&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;font-weight:normal;color:#4B5563&quot;&gt;S1 rejeitado + S2 válido&lt;br&gt;Depois, estado COMPLETE&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFFBEF;strokeColor=#2B8A3E;strokeWidth=2;fontColor=#1F2937;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1230" y="155" width="310" height="125" />
        </mxCell>
