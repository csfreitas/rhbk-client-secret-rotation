        <mxCell id="manual" value="&lt;div style=&quot;font-size:18px;line-height:1.25;text-align:center;&quot;&gt;&lt;b&gt;Validade principal e convivência&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;font-weight:normal;color:#4B5563&quot;&gt;POST: S2 recebe um novo prazo de 3.650 dias.&lt;br&gt;S1 passa a valer somente pelos 120 s de convivência.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFFBEF;strokeColor=#2B8A3E;strokeWidth=2;fontColor=#1F2937;spacing=10;arcSize=12;" vertex="1" parent="1">
