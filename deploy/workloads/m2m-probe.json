{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "m2m-probe",
    "namespace": "rhbk-rotation-lab",
    "labels": {
      "app.kubernetes.io/part-of": "rhbk-secret-rotation-lab",
      "lab.rhbk/owner": "client-secret-rotation",
      "app.kubernetes.io/name": "m2m-probe"
    }
  },
  "spec": {
    "replicas": 2,
    "revisionHistoryLimit": 5,
    "minReadySeconds": 4,
    "progressDeadlineSeconds": 90,
    "strategy": {
      "type": "RollingUpdate",
      "rollingUpdate": {
        "maxUnavailable": 0,
        "maxSurge": 1
      }
    },
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "m2m-probe",
        "app.kubernetes.io/part-of": "rhbk-secret-rotation-lab",
        "lab.rhbk/owner": "client-secret-rotation"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "m2m-probe",
          "lab.rhbk/generation": "v0001",
          "app.kubernetes.io/part-of": "rhbk-secret-rotation-lab",
          "lab.rhbk/owner": "client-secret-rotation"
        }
      },
      "spec": {
        "serviceAccountName": "m2m-probe",
        "automountServiceAccountToken": false,
        "terminationGracePeriodSeconds": 10,
        "securityContext": {
          "runAsNonRoot": true,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "probe",
            "image": "image-registry.openshift-image-registry.svc:5000/rhbk-rotation-lab/m2m-probe:build-required",
            "imagePullPolicy": "IfNotPresent",
            "env": [
              {
                "name": "TOKEN_URL",
                "value": "https://rhbk-rotation.apps-crc.testing/realms/lab-secret-rotation/protocol/openid-connect/token"
              },
              {
                "name": "CLIENT_ID",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "catalogo-api-cred-v0001",
                    "key": "client-id"
                  }
                }
              },
              {
                "name": "CLIENT_SECRET",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "catalogo-api-cred-v0001",
                    "key": "client-secret"
                  }
                }
              },
              {
                "name": "GENERATION",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "catalogo-api-cred-v0001",
                    "key": "generation"
                  }
                }
              },
              {
                "name": "POD_NAME",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "metadata.name"
                  }
                }
              },
              {
                "name": "PROBE_ROLE",
                "value": "main"
              },
              {
                "name": "PROBE_INTERVAL_SECONDS",
                "value": "2"
              },
              {
                "name": "REQUEST_TIMEOUT_SECONDS",
                "value": "5"
              },
              {
                "name": "TLS_CA_FILE",
                "value": "/etc/rhbk-ca/ca.crt"
              }
            ],
            "ports": [
              {
                "name": "status",
                "containerPort": 8080
              }
            ],
            "resources": {
              "requests": {
                "cpu": "25m",
                "memory": "48Mi"
              },
              "limits": {
                "cpu": "200m",
                "memory": "128Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "volumeMounts": [
              {
                "name": "rhbk-ca",
                "mountPath": "/etc/rhbk-ca",
                "readOnly": true
              }
            ],
            "readinessProbe": {
              "httpGet": {
                "path": "/readyz",
                "port": "status"
              },
              "periodSeconds": 2,
              "timeoutSeconds": 1,
              "failureThreshold": 2
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": "status"
              },
              "initialDelaySeconds": 10,
              "periodSeconds": 10,
              "timeoutSeconds": 1,
              "failureThreshold": 3
            }
          }
        ],
        "volumes": [
          {
            "name": "rhbk-ca",
            "configMap": {
              "name": "rhbk-route-ca"
            }
          }
        ]
      }
    }
  }
}
