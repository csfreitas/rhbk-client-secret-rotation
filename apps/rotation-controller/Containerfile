# Select an immutable Python image compatible with the target node architecture.
ARG PYTHON_IMAGE
FROM ${PYTHON_IMAGE}
WORKDIR /opt/lab
COPY controller.py /opt/lab/controller.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 1001
ENTRYPOINT ["python3", "/opt/lab/controller.py"]
CMD ["evaluate"]
