# Supply a verified immutable Python image through --build-arg PYTHON_IMAGE=...@sha256:...
ARG PYTHON_IMAGE=registry.redhat.io/ubi9/python-312@sha256:1dbe53dbe4194bc25ea213246f7b2625804b2e102e4348d7e8d65507b92fd43b
FROM ${PYTHON_IMAGE}
WORKDIR /opt/app
COPY --chown=1001:0 probe.py /opt/app/probe.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 1001
EXPOSE 8080
ENTRYPOINT ["python3", "/opt/app/probe.py"]
