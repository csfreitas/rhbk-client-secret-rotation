# Supply a verified immutable Python image through --build-arg PYTHON_IMAGE=...@sha256:...
ARG PYTHON_IMAGE
FROM ${PYTHON_IMAGE}
WORKDIR /opt/app
COPY --chown=1001:0 probe.py /opt/app/probe.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 1001
EXPOSE 8080
ENTRYPOINT ["python3", "/opt/app/probe.py"]
